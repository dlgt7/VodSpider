// XBPQ 规则配置写法说明（中文键版本）
// 基于 com.github.catvod.spider.XBPQ.java 与 XBPQKey.java 源码逐一核对整理
// 所有键均已在 XBPQKey 注册表中登记；字段值留空 / "空" / "&&" 视为未配置
//
// 书写规范：
//   && 截取语法："前缀&&后缀" → 截取前缀与后缀之间的内容（正则转义后 DOTALL 非贪婪匹配，命中多处取全部）
//   多段 &&："A&&B&&C&&D" → 逐段定位：先取 A..B，再在其中取 C..D
//   备用选择器："规则1||规则2" → 依次尝试，取第一个非空结果
//   后处理器：值末尾追加 [替换:旧>>新#旧>>新] / [包含:关键词] / [不包含:关键词]
//     [替换:] 支持 * 通配（转为 .* 正则），# 分隔多组替换
//   CSS 模式：规则以 "css:" 或 "css://" 开头时使用 Jsoup CSS 选择器（由 isCssModeEnabled 自动分流）
//   {{变量}}：最多 10 轮递归展开，内置 {{主页url}} {{站名}} {{作者}} {{分类url}} {{搜索url}}
//     {{后缀}} {{密钥}} {{域名-c}} {{主页url-c}}
//   分节写法：分类/搜索等也可写成子对象（cateManual、search{url,vod_id,...}），扁平键自动归一化
//
// 中文键与英文键等价，XBPQKey.norm 加载时自动转换（英文键大小写不敏感）
// 本版如实标注：部分键仅注册、引擎暂不消费（见文末附录）

{
    //==================== 一、基础信息 ====================

    //站名
    "站名": "示例站点",
    //作者（{{作者}} 变量来源）
    "作者": "",
    //主页地址，用于相对路径补全（addHttpPrefix）和 {{主页url}} 变量
    "主页url": "https://www.example.com",
    //请求头。支持三种写法（parseHeader）：
    //  1) 简写："电脑"/"PC_UA" → 内置 PC UA；"手机"/"MOBILE_UA" → 内置移动 UA
    //  2) JSON 对象：{"User-Agent":"...", "Referer":"..."}
    //  3) 键$值 复合（# 分隔多对）："User-Agent$Mozilla/5.0#Referer$https://example.com"
    "请求头": "PC_UA",
    //公共请求头（别名 公共头），JSON 对象形式，与 请求头 合并生效
    "公共请求头": "",
    //User 请求头（别名 user），独立 User 头配置
    "User": "",
    //UserAgent / Referer 单独键
    "UserAgent": "",
    "Referer": "",
    //页面编码（别名 charset），默认 UTF-8，GBK/GB2312 站点配置后响应强制矫正
    "编码": "UTF-8",
    //请求超时，单位秒，默认 10
    "超时": "10",
    //请求重试次数，默认 1 次
    "重试": "1",
    //内网放行（别名 allowInternal），"1"=允许内网回源（仅调试用，proxy 入口不受此影响）
    "内网放行": "0",
    //打开调试（别名 debug），"1"=SpiderDebug 日志全开
    "打开调试": "0",
    //平台（别名 平台类型），影响 UA/行为适配
    "平台": "",
    //域名后缀（{{后缀}} 变量来源）
    "后缀": "",
    //请求间隔（别名 限流间隔），毫秒，串行请求限流
    "请求间隔": "",
    //镜像域名（别名 备用域名），站点 5xx/超时失败时逐个切换重试
    "镜像域名": "",
    //参数追加（别名 全局参数/追加参数），追加到每次请求 URL 的固定参数
    "参数追加": "",
    //默认封面，列表图片为空时兜底
    "默认封面": "",
    //翻页终点标记（别名 分页结束标记），响应命中则停止翻页
    "翻页终点标记": "",
    //偏移分页，"1"=用 {offset} 偏移量分页（配合 每页条数）
    "偏移分页": "0",
    //每页条数，偏移分页/页总数计算的每页条数，默认 20
    "每页条数": "20",
    //宝塔 WAF，"1"=遇到宝塔拦截页自动提取 btwaf cookie 重试
    "宝塔WAF": "",
    //反爬超时，毫秒，反爬重试的总预算，0=默认
    "反爬超时": "",
    //错误码 / 失败码，# 分隔，响应 JSON code 命中判定为失败
    "错误码": "",
    "失败码": "",
    //成功码，# 分隔，响应 JSON code 命中判定为成功
    "成功码": "",
    //偏好菜单（JSON 数组），首页插入自定义偏好菜单项
    "偏好菜单": "",
    //功能入口，"1"=在分类列表头部插入"置顶搜索和设置"等功能入口
    "功能入口": "",
    //滑块 Key 接口 / 打码接口 / 验证类型：滑块验证配置（auto=自动）
    "滑块Key接口": "",
    "打码接口": "",
    "验证类型": "auto",

    //==================== 二、动态域名 ====================

    //动态域名链（别名 动态域名）。支持 {{变量}} 与 [替换:] 后处理器。
    //规则加载时 applyDynamicDomain()：展开+校验 origin 合法后，
    //把整份规则中旧 主页url 的 origin 全局替换为新 origin（域名切换）。
    "域名-c": "{{主页url-c}}[替换:https://>>https://666.]",
    //主页地址备选（别名 备用主页），作为 {{主页url-c}} 变量来源；
    //仅 动态域名 有效时才触发域名切换
    "主页url-c": "https://www.example2.com",

    //==================== 三、分类配置 ====================

    //分类 URL 模板（别名 cateUrl/list_url）。
    //占位符：{cateId}=分类ID，{catePg}=页码（{catePg}/{catepg} 大小写两种写法均支持），
    //{offset}=偏移分页；筛选参数（{class}/{area}/{year} 等）不在此替换，由 extend 筛选另行拼接。
    "分类url": "https://www.example.com/list/{cateId}/page/{catePg}.html",
    //分类列表（别名 cate）。
    //写法 A（最常见）："电影$1#电视剧$2#综艺$3"（名$值，# 分隔）
    //写法 B（无 $ 的纯文本）：整串作为一个分类名，type_id 从 分类url 中提取（extractCateId），
    //  仅在写法 A 未配置任何 $ 项时兜底生效
    "分类": "电影$1#电视剧$2#综艺$3#动漫$4",
    //分类名称 / 分类值（别名 cateName/cateValue），& 分隔并行数组，优先级高于 分类
    "分类名称": "",
    "分类值": "",
    //分类二次截取，"前缀&&后缀"，先截取分类区域再解析
    "分类二次截取": "",
    //分类数组，定位每个分类项的 HTML 区块
    "分类数组": "",
    //分类标题
    "分类标题": ">&&<",
    //分类ID
    "分类ID": "href=\"&&\"",
    //分类白名单，逗号/& 分隔，只保留名单内分类
    "分类白名单": "",
    //筛选数据，JSON 对象，键为分类 type_id
    //格式：{"1":[{"key":"class","name":"剧情","value":[{"n":"全部","v":""},...]},...]}
    "筛选": {},
    //筛选数据备用 URL，优先级高于内联 筛选，抓取后按筛选替换组改写
    "筛选数据": "",
    //筛选替换组：从筛选数据 URL 抓取后按 替换词 改写名称/值
    "筛选子分类名称": "",  "筛选子分类替换词": "",
    "筛选类型名称": "",    "筛选类型替换词": "",
    "筛选地区名称": "",    "筛选地区替换词": "",
    "筛选年份名称": "",    "筛选年份替换词": "",
    "筛选语言名称": "",    "筛选语言替换词": "",
    "筛选排序名称": "",    "筛选排序替换词": "",
    //排序 / 排序值（别名 sortType/sortValue），自动生成 by 排序筛选器
    "排序": "",
    "排序值": "",
    //热门推荐，"1"=homeVideoContent 聚合主页视频到首页列表
    "热门推荐": "0",
    //列表显示，"1"=列表展示模式开关
    "列表显示": "",

    //==================== 四、首页推荐 ====================

    //首页（别名 homePage）。homeVideoContent 首页聚合配置：
    //  纯数字（如 "20"）→ 每个分类聚合条数上限
    //  "名称$分类ID#名称$分类ID" → 只聚合指定分区
    "首页": "",
    //起始页，分类页码偏移，默认 1
    "起始页": "1",

    //==================== 五、列表解析配置（分类页） ====================

    //列表数组。
    //&& 语法：".stui-vodlist__box&&</li>" → 每个区块为一部影片
    //CSS 语法（css: 开头）："css:.stui-vodlist__box"
    "数组": ".stui-vodlist__box&&</li>",
    //二次截取，先截取再按 数组 解析（全名写法 列表二次截取 同义）
    "二次截取": "",
    //标题
    "标题": "title=\"&&\"",
    //链接
    "链接": "href=\"&&\"",
    //图片（图片属性 可指定真实地址属性名如 data-original；值以 http 开头为固定图片）
    "图片": "data-original=\"&&\"",
    //副标题（别名 分类副标题，兼容分节写法）
    "副标题": ".pic-text&&Text",
    //链接前缀（别名 分类片单链接前缀）
    "链接前缀": "https://www.example.com",
    //链接后缀（别名 分类片单链接后缀）
    "链接后缀": "",
    //过滤词，命中则从列表剔除，"&&" 分隔多个关键词
    "过滤词": "",
    //倒序（别名 倒序播放），"1"=列表倒序输出
    "倒序": "0",
    //列表模式 / 列表 JSON 字段组（JSON 模式时按 JSON 解析分类页）
    "列表模式": "",
    "列表JSON路径": "",
    "列表JSON名称": "",
    "列表JSONID": "",
    "列表JSON图片": "",
    "列表JSON状态": "",
    //坏条目跳过（默认 1=单条解析失败跳过；"0"=整页失败）
    "坏条目跳过": "1",
    //列表总页数规则（别名 总页数/总数规则），从页面提取总页数的截取规则
    "列表总页数规则": "",
    //图片属性（别名 懒加载属性），图片懒加载真实地址属性名
    "图片属性": "",

    //==================== 六、分类 JSON 模式 ====================

    //分类截取模式，"0"=JSON 模式，默认空=网页截取模式
    "分类截取模式": "",
    //分类 JSON 字段组（分类截取模式=0 时生效），列表 为多级路径如 "list.data"
    "分类JSON列表": "",
    "分类JSON名称": "",
    "分类JSONID": "",
    "分类JSON图片": "",
    "分类JSON状态": "",

    //==================== 七、搜索配置 ====================

    //搜索 URL。
    //{wd}=搜索关键词（扁平 搜索url 写法自动 URL 编码；分节 search.url 写法原样替换），
    //{pg}=页码（经 搜索起始页码 偏移）。
    "搜索url": "https://www.example.com/search.php?wd={wd}&page={pg}",
    //搜索模式："0"=优先 JSON 解析（默认），"1"=优先网页截取；两者互为兜底
    "搜索模式": "0",
    //搜索二次截取
    "搜索二次截取": "",
    //搜索数组
    "搜索数组": ".searchlist&&</li>",
    //搜索标题
    "搜索标题": "title=\"&&\"",
    //搜索链接
    "搜索链接": "href=\"&&\"",
    //搜索图片
    "搜索图片": "data-original=\"&&\"",
    //搜索副标题
    "搜索副标题": "",
    //搜索简介
    "搜索简介": "",
    //搜索请求头，独立于公共请求头（写法同 请求头）
    "搜索请求头": "",
    //搜索链接前缀 / 搜索后缀
    "搜索链接前缀": "",
    "搜索后缀": "",
    //搜索起始页码（别名 搜索起始页），搜索页码偏移
    "搜索起始页码": "",
    //搜索词分隔符（别名 关键词分隔符），关键词中空格替换为该分隔符（如 "+"）
    "搜索词分隔符": "",
    //搜索 JSON 字段组（优先于网页截取，列表 为 JSON 路径，其余为字段名）
    "搜索JSON路径": "",
    "搜索JSON名称": "",
    "搜索JSONID": "",
    "搜索JSON图片": "",
    "搜索JSON状态": "",

    //==================== 八、详情页配置 ====================

    //详情 URL 模板。支持 ${vid} 和 {vid} 占位符，${vid} 优先；
    //为空时按 主页url 主机拼接 vid。
    "详情url": "",
    //详情数组，定位详情页主体区块
    "详情数组": "",
    //详情二次截取
    "详情二次截取": "",
    //影片名称，详情标题覆盖
    "影片名称": "",
    //影片类型（别名 类型）
    "影片类型": "类型:&&<br",
    //影片年代（别名 年份）
    "影片年代": "年份:&&<br",
    //影片地区（别名 地区）
    "影片地区": "地区:&&<br",
    //导演
    "导演": "导演:&&<br",
    //主演
    "主演": "演员:&&<br",
    //简介（别名 剧情）
    "简介": "简介:&&</p>",
    //状态/备注
    "状态": "",
    //详情分隔符（别名 detail_label_split），"| "分隔多个 label 词，
    //从详情页纯文本按 label 提取字段（导演：/主演：/地区：等自动映射 vod_* 字段，仅补缺）
    "详情分隔符": "导演：|主演：|地区：|年份：|状态：",
    //详情合并字段（别名 detail_content_merge），逗号分隔的 vod_* 字段名，
    //其值以换行追加到 vod_content（仅增量，不覆盖）
    "详情合并字段": "",
    //播放图片，缺封面兜底图
    "播放图片": "",

    //==================== 九、线路与播放配置 ====================

    //线路数组，每条线路区块定位；CSS 模式时以此判断进入 CSS 提取
    "线路数组": ".stui-pannel__head&&</h3>",
    //线路标题
    "线路标题": ">&&<",
    //线路二次截取
    "线路二次截取": "",
    //多线数组，多线模式区块定位
    "多线数组": "",
    //多线链接（别名 线路链接），每条线路的播放页 URL
    "多线链接": "",
    //多线二次截取
    "多线二次截取": "",
    //多线链接前缀 / 后缀
    "多线链接前缀": "",
    "多线链接后缀": "",
    //线路合并，"1"=多线路合并为单一线路（线路名取第一条原始名称）
    "线路合并": "0",
    //线路重命名（别名 线路映射），"旧名>>新名#旧名>>新名"
    "线路重命名": "",
    //播放二次截取
    "播放二次截取": "",
    //播放数组，选集区块定位
    "播放数组": ".stui-content__playlist&&</ul>",
    //播放列表，选集元素定位（li 标签等）
    "播放列表": "li",
    //播放标题，选集标题
    "播放标题": ">&&<",
    //播放链接，选集链接
    "播放链接": "href=\"&&\"",
    //剧集过滤，"&&" 分隔过滤词，命中则跳过该集
    "剧集过滤": "",
    //剧集排序（别名 选集排序），"1"=选集按集数号排序
    "剧集排序": "",
    //剧集去重（别名 选集去重），"1"=选集按链接去重
    "剧集去重": "",
    //清晰度优先（别名 剧集清晰度/画质优先），"蓝光>>超清>>高清" 优先级链
    "清晰度优先": "",
    //选集链接加前缀 / 选集链接加后缀，每条集数链接自动拼接
    "选集链接加前缀": "",
    "选集链接加后缀": "",
    //空播放兜底 / 空播放线路名，无集时补一条占位线路
    "空播放兜底": "",
    "空播放线路名": "",
    //跳转播放链接，提取播放页中的真实视频地址；为空时直接嗅探原 URL
    "跳转播放链接": "",
    //直接播放："0"=走详情线路解析（默认）；"1"=分类片单链接直接播放；"2"=详情选集链接直接播放
    "直接播放": "0",
    //播放链接前缀 / 播放链接后缀（如 "#isVideo=true#" 强制识别）
    "播放链接前缀": "",
    "播放链接后缀": "",
    //播放请求头，JSON 对象，直链视频专用请求头
    "播放请求头": "",
    //播放去参数（别名 剥离参数），"1"=播放链接剥离 query 参数
    "播放去参数": "",
    //分析 MacPlayer，"2"=优先用正则解析脚本块（更快更可靠）
    "分析MacPlayer": "",
    //自动 Maccms，"1"=字段缺失时注入 Maccms 默认规则
    "自动Maccms": "",

    //==================== 十、嗅探配置 ====================

    //免嗅，"0"=开启嗅探，"1"=免嗅探（直链直出）
    "免嗅": "0",
    //嗅探词，匹配关键词（# 分隔）；未配置时按 .m3u8/.mp4/.flv/.avi/.mkv/.rmvb/.wmv/.mov 默认扩展名判断
    "嗅探词": "",
    //视频过滤词，# 分隔，命中则强制判定为非视频（优先级高于嗅探词）
    "视频过滤词": "",

    //==================== 十一、图片代理 / 弹幕配置 ====================

    //图片代理，"1"=图片走 proxy:// 本地代理
    "图片代理": "0",
    //图片代理前缀，远端 Base64 图床中转地址
    "图片代理前缀": "",
    //代理密钥，MD5(图片+代理密钥) 签名防代理滥用
    "代理密钥": "",
    //图片代理白名单（别名 代理域名白名单），# 分隔，仅白名单域名走代理
    "图片代理白名单": "",
    //弹幕接口，配置后播放时自动注入 danmaku 代理参数，JSON 自动转 B 站风格 XML
    "弹幕url": "",

    //==================== 十二、CSS（Jsoup）模块键 ====================

    "CSS 选择器": "",
    "CSS 提取": "",
    "CSS 属性": "",
    "JSOUP 解析": "",
    "列表CSS容器": ""
}

//==================== 附录一：分节规则写法 ====================
//
// 除扁平键外，支持分节子对象写法（规则加载时自动归一化为扁平键）：
//   "cateManual": {"电影":"1","电视剧":"2"}          → 分类映射形式
//   "search": {"url":"...","vod_id":"...","vod_name":"...","vod_pic":"..."}
//        → 分节搜索配置（vod_id 等的值 = JSON 字段名，用于 JSON 搜索）
// 注意：分节 search.url 中的 {wd} 原样替换（不 URL 编码）；
//       扁平 搜索url 中的 {wd} 自动 URLEncoder.encode。
