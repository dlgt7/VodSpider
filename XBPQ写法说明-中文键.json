// XBPQ 规则配置写法说明（中文键版本）
// 基于 com.github.catvod.spider.XBPQ.java 源码及 RuleConfig.CHINESE_KEY_MAP 整理
// 所有键均已与代码逐一核对；字段值留空 / "空" / "&&" 视为未配置
//
// 书写规范：
//   && 截取语法："前缀&&后缀" → 截取前缀与后缀之间的内容
//   备用选择器："规则1||规则2" → 依次尝试，取第一个非空结果
//   后处理器：值末尾追加 [替换:旧>>新] / [包含:关键词] / [不包含:关键词]
//   CSS 模式：规则以 "css:" 或 "css://" 开头时使用 Jsoup CSS 选择器（由 ExtractorFactory 自动分流）
//   p:tag->text 等 CSS 简写语法也被自动识别
//   {{变量}}：支持最多 10 轮递归展开，内置 {{主页url}} {{站名}} {{作者}} {{域名-c}} {{主页url-c}} 等
//   [firstPage=...]：分类/搜索 URL 首页特殊链接语法
//   ;post：URL 末尾加 ";post" 表示 POST 请求
//   [工具:xxx]：工具链标记，见下方"工具链"章节
//
// 中文键与英文键等价，JSON 解析时自动转换；推荐使用中文键更直观

{
    //==================== 一、基础信息 ====================

    //站名
    "站名": "示例站点",
    //主页地址，用于相对路径补全和 {{主页url}} 变量
    "主页url": "https://www.example.com",
    //请求头，支持三种写法：
    //  1) 简写： "PC_UA" / "手机" / "MOBILE_UA" / "IOS_UA"
    //  2) JSON 对象： {"User-Agent":"...", "Referer":"..."}
    //  3) Key:Value 复合（# 分隔）："User-Agent$PC_UA#Referer$https://example.com"
    "请求头": "PC_UA",
    //页面编码，默认 UTF-8，GBK 站点填 "GBK"
    "编码": "UTF-8",
    //请求超时（秒），默认 10
    "超时": "10",
    //请求重试次数，默认 1 次（不重试）
    "重试": "1",
    //SSRF 放行内网，"1"=允许内网回源（调试用）
    "allow_internal": "0",

    //==================== 二、动态域名 ====================

    //动态域名链（英文键 dynamic_domain），优先级最高，可配合 [替换:] 语法做域名替换
    //示例："{{主页url-c}}[替换:https://>>https://666.]"
    "域名-c": "",
    //主页地址备选（英文键 home_url_c），优先级低于 域名-c，用于动态域名失败时回退
    "主页url-c": "",

    //==================== 三、分类配置 ====================

    //分类 URL 模板。
    //占位符：{cateId}=分类ID，{catePg}=页码，{class}/{area}/{year}/{lang}/{by} 等由筛选 extend 填充。
    //支持 [firstPage=http://xxx] 语法：页码=起始页时优先使用中括号内链接。
    "分类url": "https://www.example.com/list/{cateId}/page/{catePg}.html",
    //分类列表。
    //写法 A（最常见）： "电影$1#电视剧$2#综艺$3"  （名$值，# 分隔）
    //写法 B（& 分隔纯名称）： "电影&电视剧&综艺"  ，名称同时作为 type_id
    //写法 C：配合 分类名称/分类值 并行数组： "电影&电视剧" + "1&2"
    "分类": "电影$1#电视剧$2#综艺$3#动漫$4",
    //分类二次截取，格式 "前缀&&后缀"
    "分类二次截取": "",
    //分类数组，定位每个分类项的 HTML 区块
    "分类数组": "",
    //分类标题
    "分类标题": ">&&<",
    //分类ID
    "分类ID": "href=\"&&\"",
    //筛选数据，JSON 对象，键为分类 type_id
    //格式：{"1":[{"key":"class","name":"剧情","value":[{"n":"全部","v":""},{"n":"喜剧","v":"喜剧"}]},...]}
    "筛选": {},
    //筛选数据备用 URL（英文键 filterdata），优先级高于内联 筛选 字段
    "筛选数据": "",
    //筛选子分类名称（英文键 fclass_name），从筛选数据 URL 抓取后替换子分类名称
    "筛选子分类名称": "",
    //筛选子分类替换词（英文键 fclass_value）
    "筛选子分类替换词": "",
    //筛选类型名称（英文键 fcatelog_name）
    "筛选类型名称": "",
    //筛选类型替换词（英文键 fcatelog_value）
    "筛选类型替换词": "",
    //筛选地区名称（英文键 farea_name）
    "筛选地区名称": "",
    //筛选地区替换词（英文键 farea_value）
    "筛选地区替换词": "",
    //筛选年份名称（英文键 fyear_name）
    "筛选年份名称": "",
    //筛选年份替换词（英文键 fyear_value）
    "筛选年份替换词": "",
    //筛选语言名称（英文键 flang_name）
    "筛选语言名称": "",
    //筛选语言替换词（英文键 flang_value）
    "筛选语言替换词": "",
    //筛选排序名称（英文键 fsort_name）
    "筛选排序名称": "",
    //筛选排序替换词（英文键 fsort_value）
    "筛选排序替换词": "",

    //分类截取模式，"0"=JSON 模式（配合 catjsonlist 等字段），默认 null=网页截取模式
    "分类截取模式": "",
    //分类 JSON 列表路径（cat_mode=0 时生效），支持多级路径如 "list.data"
    "分类JSON列表": "",
    //分类 JSON 名称字段
    "分类JSON名称": "",
    //分类 JSON ID 字段
    "分类JSONID": "",
    //分类 JSON 图片字段
    "分类JSON图片": "",
    //分类 JSON 状态/备注字段
    "分类JSON状态": "",
    //分类片单链接前缀（cat_prefix）：拼接在 vod_id 中的链接前面
    "分类片单链接前缀": "",
    //分类片单链接后缀（cat_suffix）：拼接在 vod_id 中的链接后面
    "分类片单链接后缀": "",
    //分类副标题（cat_subtitle）：主列表截取规则中的 subtitle 字段名，回填到 vod_remarks
    "分类副标题": "",

    //起始页偏移，默认 1
    "起始页": "1",
    //搜索起始页码偏移（sea_firstpage）
    "搜索起始页码": "",
    //首页推荐数量，填纯数字（如 "20"）或 "名称$分类ID#名称$分类ID"
    "首页": "",
    //热门推荐，"1"=聚合主页视频到首页列表
    "热门推荐": "0",
    //倒序，"1"=列表倒序输出
    "倒序": "0",
    //特殊分类链接（英文键 特殊分类链接），name$url#name$url 格式，优先级高于 分类，支持 {{域名-c}} 变量
    "特殊分类链接": "",

    //==================== 四、列表解析配置 ====================

    //列表数组。
    //&& 语法："<article&&</li>" → 每个 article 到 /li 之间为一部影片
    //CSS 语法（以 css: 开头）："css:.stui-vodlist__box"
    "数组": ".stui-vodlist__box&&</li>",
    //列表二次截取，先截取再按 数组 解析
    "二次截取": "",
    //标题
    "标题": "title=\"&&\"",
    //链接
    "链接": "href=\"&&\"",
    //图片，值以 http 开头时作为固定图片 URL
    "图片": "data-original=\"&&\"",
    //副标题
    "副标题": ".pic-text&&Text",
    //链接前缀，链接补前缀
    "链接前缀": "https://www.example.com",
    //链接后缀
    "链接后缀": "",
    //过滤词，命中则从列表剔除，"&&" 分隔多个关键词
    "过滤词": "",

    //==================== 五、搜索配置 ====================

    //搜索 URL。
    //{wd}=搜索关键词（自动 URL 编码），{pg}=页码；末尾加 ";post" 表示 POST 请求。
    "搜索url": "https://www.example.com/search.php?wd={wd}&page={pg}",
    //搜索模式："0"=优先 JSON 解析，"1"=优先网页截取（两者互为兜底）
    "搜索模式": "1",
    //搜索二次截取
    "搜索二次截取": "",
    //搜索数组
    "搜索数组": ".searchlist&&</li>",
    //搜索标题
    "搜索标题": "title=\"&&\"",
    //搜索链接
    "搜索链接": "href=\"&&\"",
    //搜索图片
    "搜索图片": "data-original=\"&&\"",
    //搜索副标题
    "搜索副标题": "",
    //搜索请求头，独立于公共请求头
    "搜索请求头": "",
    //搜索链接前缀
    "搜索链接前缀": "",
    //搜索链接后缀
    "搜索后缀": "",
    //搜索简介
    "搜索简介": "",

    //==================== 六、详情页配置 ====================

    //详情 URL 模板。
    //支持 ${vid} 和 {vid} 占位符，${vid} 优先（防止残留 "$" 前缀）。
    //为空时按 主页url 主机拼接 vid。
    "详情url": "",
    //详情数组，定位详情页主体区块
    "详情数组": "",
    //详情二次截取
    "详情二次截取": "",
    //影片类型
    "类型": "类型:&&<br",
    //影片年代
    "年份": "年份:&&<br",
    //影片地区
    "地区": "地区:&&<br",
    //导演
    "导演": "导演:&&<br",
    //主演
    "主演": "演员:&&<br",
    //简介
    "简介": "简介:&&</p>",
    //状态/备注
    "状态": "",
    //影片名称（别名 vod_name，可用于详情标题覆盖）
    "影片名称": "",

    //详情分隔符。
    //从详情页纯文本中按 label 词提取字段，"| " 分隔多个 label。
    //自动映射：导演→vod_director、主演/演员→vod_actor、地区/国家→vod_area、
    //年份/年代→vod_year、状态/备注/更新→vod_remarks、类型/分类→type_name、
    //简介/剧情/介绍→vod_content。仅补缺，不覆盖已有值。
    "详情分隔符": "导演：|主演：|地区：|年份：|状态：",
    //详情合并字段。
    //逗号分隔的 vod_* 字段名，将其值以换行追加到 vod_content。
    //例如 "状态,类型,年份"，仅增量合并，不覆盖已有正文。
    "详情合并字段": "",

    //==================== 七、线路与播放配置 ====================

    //线路二次截取
    "线路二次截取": "",
    //线路数组，每条线路区块定位
    //CSS 模式时以此字段判断是否进入 CSS 提取
    "线路数组": ".stui-pannel__head&&</h3>",
    //线路标题
    "线路标题": ">&&<",

    //多线数组，多线模式区块定位
    "multi_line_array": "",
    //多线链接，每条线路的播放页 URL
    "multi_line_url": "",
    //多线链接前缀
    "multi_line_prefix": "",
    //多线链接后缀
    "multi_line_suffix": "",
    //线路合并，"1"=多线路合并为单一线路
    "线路合并": "0",

    //播放二次截取
    "播放二次截取": "",
    //播放数组，选集区块定位
    "播放数组": ".stui-content__playlist&&</ul>",
    //播放列表，选集元素定位（li 标签等）
    "播放列表": "li",
    //播放标题，选集标题
    "播放标题": ">&&<",
    //播放链接，选集链接
    "播放链接": "href=\"&&\"",
    //跳转播放链接。
    //提取播放页中的真实视频地址；为空时跳过跳转，直接嗅探原 URL。
    "跳转播放链接": "",
    //剧集过滤，"&&" 分隔过滤词，命中则跳过该集
    "剧集过滤": "",
    //空播放兜底，无集时补一条占位线路
    "空播放兜底": "",
    //空播放线路名，兜底线路线路名
    "空播放线路名": "",
    //选集链接加前缀（epiurl_prefix）
    "选集链接加前缀": "",
    //选集链接加后缀（epiurl_suffix）
    "选集链接加后缀": "",

    //直接播放。
    //"0"=走详情线路解析；"1"=分类片单链接直接播放；"2"=详情选集链接直接播放
    "直接播放": "0",
    //播放链接前缀
    "播放链接前缀": "",
    //播放链接后缀，如 "#isVideo=true#" 强制识别
    "播放链接后缀": "",
    //播放请求头，JSON 对象，直链视频专用请求头
    "播放请求头": "",
    //缺封面兜底图
    "播放图片": "",
    //视频过滤词（video_filter），# 分隔，命中则强制返回 false（非视频）
    "视频过滤词": "",

    //==================== 八、嗅探配置 ====================

    //免嗅，"0"=开启嗅探，"1"=免嗅探（直链直出）
    "免嗅": "0",
    //嗅探词，匹配关键词（# 分隔）；
    //未配置时按 .m3u8/.mp4/.flv/.avi/.mkv/.rmvb/.wmv/.mov 默认扩展名判断
    "嗅探词": "",
    //过滤词，命中则排除（# 分隔）
    "过滤词": ".html#=http",

    //==================== 九、图片代理配置 ====================

    //图片代理，"1"=图片走 proxy:// 本地代理
    "图片代理": "0",
    //图片代理前缀，远端 Base64 图床中转地址
    "图片代理前缀": "",
    //代理密钥，MD5(pic+代理密钥) 签名防代理滥用
    "代理密钥": "",

    //==================== 十、扩展功能配置 ====================

    //弹幕接口，配置后播放时自动注入 danmaku 代理参数
    "弹幕url": "",
    //直播流地址
    "liveUrl": "",
    //Maccms 自动注入，"1"=字段缺失时注入 Maccms 默认规则
    "自动Maccms": "0",
    //分析 MacPlayer 模式，"2"=优先用正则解析脚本块（更快更可靠）
    "分析MacPlayer": "",

    //==================== 十一、WebView 渲染配置 ====================

    //启用 WebView 渲染，"1"=使用 WebView 代替 OkHttp
    "web_view": "0",
    //页面加载后额外等待毫秒数，给 AJAX 异步请求时间
    "web_view_wait": "",
    //DOM 就绪选择器（CSS 或 JS 表达式），满足后再抽取 HTML
    "web_view_ready": "",
    //DOM 就绪轮询超时（毫秒），默认 10000
    "web_view_ready_timeout": "10000"
}

//==================== 附录：工具链语法 ====================
//
// 在任意规则值中嵌入 [工具:xxx] 标记，执行时自动替换：
//   [工具:源码]               抓取发布页 HTML 并返回（配合 发布页 使用）
//   [工具:重定向]             跟随 HTTP 重定向获取最终 URL
//   [工具:解url]              URL 解码
//   [工具:解b64]              Base64 解码（与 [工具:Base64#解密] 等价）
//   [工具:SHA]                SHA-256 哈希
//   [工具:1截取N]             按分隔符取第 N 个片段（N 从 1 开始）
//   [工具:随机字符-N-唯一]     生成 N 位随机字符串
//   [工具:源码转b64#解密aes-key-iv-AES/CBC/PKCS7Padding]  AES 解密
//
// [替换:a>>b#x>>y] 语法不限于 [工具:xxx] 内，可直接写在任意规则值末尾。
//
//==================== 附录：预留字段（暂未实现） ====================
//
// 以下键已在 CHINESE_KEY_MAP 中注册，供未来版本使用：
//   "二级目录"       二级目录过滤（格式：目录名|mode，mode 含 folder 时按目录名过滤分类）
//   "二级ID"         二级页面 ID 字段
//   "发布页"         发布页 URL（配合 [工具:源码] 使用）
//   "发布站-b"       备用发布站 B
//   "原始网址-b"     备用原始网址 B
//   "固定直链"       固定直链 URL
//
//==================== 附录：动态域名变量链示例 ====================
//
//  {
//      "主页url": "https://www.example.com",
//      "域名-c": "{{主页url-c}}[替换:https://>>https://666.]",
//      "主页url-c": "https://www.example2.com"
//  }
//  说明：getHomeUrl() 优先返回展开后的 dynamic_domain（即 {{主页url-c}} 展开后再做替换），
//       其次返回 home_url_c，最后回退到主页url。
